# Optional identity. Leave unset to reuse the saved key or generate one on first start.
# A different key needs a different DATA_DIR; existing account state is never overwritten.
# NSEC=nsec1...

# Profile display name. Defaults to Bitcoin Price (Example Anagram Bot).
# NAME="Bitcoin Price (Example Anagram Bot)"

# Optional. Defaults match Anagram's app relays. Comma-separated websocket URLs.
# RELAYS=wss://relay.nostr.com,wss://relay.damus.io,wss://nostr.mom,wss://nostr.bitcoiner.social,wss://nos.lol

# Persistent identity, invitations, subscriptions and delivery queue.
# DATA_DIR=./data

# Price provider. It must return JSON like {"USD":67123,"EUR":58234}. HTTPS is required.
# PRICE_URL=https://mempool.space/api/v1/prices

# Cache successful prices for this many seconds: a whole number from 0 to 300 (0 disables
# the cache). Other values stop the bot at startup. A cached price up to 5 minutes old is
# still shown, clearly marked as stale, while the provider is down.
# PRICE_CACHE_SECONDS=60

# Currency used when a message does not name one. Three letters, as returned by the provider.
# Checked at startup: the bot refuses to start if the provider does not offer it.
# PRICE_DEFAULT_CURRENCY=USD

# Local or self-hosted development only. Set to 1 to allow a plain http:// PRICE_URL and
# addresses such as localhost or 192.168.x.x. Leave unset for any public provider.
# PRICE_ALLOW_HTTP=1

# Optional HTTPS profile picture URL. No picture is published by default.
# PICTURE_URL=https://your-site.example/bitcoin.png

# Optional NIP-05 identifier; your domain must map this name to the bot public key.
# NIP05=price@your-domain.example

# Optional public group links/naddrs, separated by commas.
# PUBLIC_GROUPS=naddr1...

# One reply per sender per this many seconds (across all chats); 0 disables.
# COOLDOWN_SECONDS=5
