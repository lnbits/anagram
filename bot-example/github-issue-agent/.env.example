# ---- Who may use the bot (everything is denied unless listed) --------------------------

# Repositories the bot may create issues in. Scope the GitHub token to exactly these.
# ALLOWED_REPOS=lnbits/anagram,lnbits/lnbits

# People allowed to use the bot, each with their own repositories ("*" = all of
# ALLOWED_REPOS). Separate people with ";" or new lines. npub1... or hex public keys.
# Required in every context: DMs, private groups and public groups.
# ALLOWED_USERS="npub1alice...=lnbits/anagram; npub1bob...=*"

# Private groups the bot may join, as the group's npub. Invite the bot from Anagram first;
# the bot then logs "Ignored a private group invitation from npub1...". Add that npub here
# and restart.
# ALLOWED_PRIVATE_GROUPS=npub1...

# Public groups the bot may join, as naddr1... values or share links. Quote share links,
# because .env treats an unquoted # as the start of a comment.
# In groups the bot handles only repositories that are public on GitHub; requests for
# private repositories work in DMs.
# ALLOWED_PUBLIC_GROUPS="naddr1..."

# ---- GitHub ------------------------------------------------------------------------------

# Fine-grained personal access token (github_pat_...): "Only select repositories" = the
# repositories above, Repository permissions → Issues: Read and write. Nothing else.
# Classic tokens (ghp_...) are refused. Keep this file private: chmod 600 .env
# GITHUB_TOKEN=github_pat_...

# For local test servers only. Leave unset to use https://api.github.com.
# GITHUB_API_URL=https://api.github.com
# GITHUB_ALLOW_LOCAL=false

# ---- Ollama ----------------------------------------------------------------------------

# Model to use. Install it first with: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2

# Ollama server. Must be on this computer unless OLLAMA_ALLOW_REMOTE=true.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_ALLOW_REMOTE=false

# Seconds to wait for one draft (includes loading the model into memory).
# OLLAMA_TIMEOUT_SECONDS=180

# ---- Limits ----------------------------------------------------------------------------

# Published issues per person in any 24 hours.
# MAX_ISSUES_PER_DAY=10
# Pending drafts per person, and how long drafts live (in memory only).
# MAX_DRAFTS_PER_USER=10
# DRAFT_TTL_HOURS=24
# Messages per person per hour (commands included), and model calls per person per hour.
# MAX_REQUESTS_PER_HOUR=60
# MAX_MODEL_CALLS_PER_HOUR=20
# Requests waiting for the model.
# MAX_QUEUE=10
# Longest accepted message, and longest issue description, in characters.
# MAX_INPUT_CHARS=4000
# MAX_BODY_CHARS=6000

# ---- Nostr identity and relays -----------------------------------------------------------

# Optional identity. Leave unset to reuse the saved key or generate one on first start.
# NSEC=nsec1...
# NAME="GitHub Issue Agent (Example Anagram Bot)"
# RELAYS=wss://relay.nostr.com,wss://relay.damus.io,wss://nostr.mom,wss://nostr.bitcoiner.social,wss://nos.lol
# DATA_DIR=./data
# PICTURE_URL=https://your-site.example/bot.png
# NIP05=issues@your-domain.example
