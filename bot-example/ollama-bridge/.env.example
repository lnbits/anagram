# ---- Who may use the bot (everything is denied unless listed) --------------------------

# People allowed to talk to the bot, as npub1... or hex public keys, separated by commas.
# Required in every context: DMs, private groups and public groups.
# ALLOWED_NPUBS=npub1...,npub1...

# Private groups the bot may join, as the group's npub. Invite the bot from Anagram first;
# the bot then logs "Ignored a private group invitation from npub1...". Add that npub here
# and restart.
# ALLOWED_PRIVATE_GROUPS=npub1...

# Public groups the bot may join, as naddr1... values or share links. Quote share links,
# because .env treats an unquoted # as the start of a comment.
# ALLOWED_PUBLIC_GROUPS="naddr1..."

# ---- Ollama ----------------------------------------------------------------------------

# Model to use. Install it first with: ollama pull llama3.2
# OLLAMA_MODEL=llama3.2

# Ollama server. Must be on this computer unless OLLAMA_ALLOW_REMOTE=true.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_ALLOW_REMOTE=false

# Seconds to wait for one answer (includes loading the model into memory).
# OLLAMA_TIMEOUT_SECONDS=120

# Optional persona/instructions for the model. Users cannot change this from chat.
# SYSTEM_PROMPT="You are a friendly assistant for our Bitcoin meetup. Answer briefly."

# ---- Limits ----------------------------------------------------------------------------

# Longest accepted question and longest reply, in characters.
# MAX_INPUT_CHARS=4000
# MAX_OUTPUT_CHARS=4000

# Messages per person per hour (commands included), and questions waiting for the model.
# MAX_REQUESTS_PER_HOUR=30
# MAX_QUEUE=10

# Conversation memory (in memory only; cleared by /reset, inactivity or a restart).
# HISTORY_MAX_MESSAGES=20
# HISTORY_MAX_CHARS=8000
# HISTORY_IDLE_MINUTES=60

# ---- Nostr identity and relays -----------------------------------------------------------

# Optional identity. Leave unset to reuse the saved key or generate one on first start.
# A different key needs a different DATA_DIR; existing account state is never overwritten.
# NSEC=nsec1...

# Profile display name.
# NAME="Ollama Bridge (Example Anagram Bot)"

# Optional. Defaults match Anagram's app relays. Comma-separated websocket URLs.
# RELAYS=wss://relay.nostr.com,wss://relay.damus.io,wss://nostr.mom,wss://nostr.bitcoiner.social,wss://nos.lol

# Persistent identity, group invitations, dedupe markers and delivery queue.
# DATA_DIR=./data

# Optional HTTPS profile picture URL and NIP-05 identifier.
# PICTURE_URL=https://your-site.example/bot.png
# NIP05=assistant@your-domain.example
