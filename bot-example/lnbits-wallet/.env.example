# ---- LNbits ----------------------------------------------------------------------------

# Your LNbits server. HTTPS is required unless LNBITS_ALLOW_HTTP=true (an instance on
# this computer or a private network only).
LNBITS_URL=https://lnbits.example
# LNBITS_ALLOW_HTTP=false

# Seconds to wait for one LNbits request.
# LNBITS_TIMEOUT_SECONDS=10

# ---- Who may use which wallet ----------------------------------------------------------

# A JSON file mapping each person's npub to one wallet's INVOICE (read) key. Never an
# admin key. Copy wallets.example.json and run: chmod 600 wallets.json
# The bot refuses to start if the file can be read by other users.
# WALLETS_FILE=./wallets.json

# Database mode (see the README): links in an encrypted database instead of WALLETS_FILE.
# A folder of its own, outside DATA_DIR, holding the keyring and the revocation ledger.
# SECRETS_DIR=/var/lib/anagram-lnbits-wallet-secrets
# Active wallets per person (1 to 7).
# MAX_CONNECTIONS_PER_USER=5
# Active wallets in all. Each costs a watcher, and connections are open to anyone with /connect.
# MAX_CONNECTIONS_TOTAL=1000
# When the bot reminds you to rotate the credential key, and how long a key must be kept for
# the backups made under it.
# KEY_ROTATION_DAYS=30
# BACKUP_RETENTION_DAYS=30

# Self-service /connect (see the README). Needs database mode. The page listens on this
# computer only: a TLS-terminating reverse proxy goes in front of it.
# CONNECT_PUBLIC_URL=https://connect.example
# CONNECT_PORT=8787
# Which LNbits servers people may use. Empty: only LNBITS_URL. A list adds servers you trust,
# and * adds any public server, through strict checks against reaching private networks.
# LNBITS_ALLOWED_ORIGINS=

# Also accept Nostr Wallet Connect strings on that page, receive only unless SEND_ENABLED is on.
# Tested only against a local mock so far: see the README.
# NWC_ENABLED=false
# For testing NWC on one computer only (test/mock-wallet.js): relays on this computer, by number,
# one by one. Needs NWC_ENABLED and a CONNECT_PUBLIC_URL on this computer. Nothing is trusted unless
# it is listed, "localhost" included. Never set this in a real deployment.
# NWC_LOCAL_TEST_RELAYS=ws://127.0.0.1:7791

# /send and /payments, through NWC connections people make to spend. Only ever tested against a
# mock: read "Sending" in the README before turning this on. Keep the wallet's own limit low.
# SEND_ENABLED=false
# Per person: one payment, 24 hours, and payments an hour.
# SEND_MAX_SATS=10000
# SEND_DAILY_SATS=50000
# SEND_PER_HOUR=5

# ---- Limits ----------------------------------------------------------------------------

# Messages per person per hour, commands included.
# MAX_REQUESTS_PER_HOUR=60

# Payments shown by a plain /history (1 to 20). /history 10 asks for a specific number.
# HISTORY_DEFAULT=5

# Largest /invoice amount in sats (1 to 10,000,000; LNbits has its own limit too), how long
# an invoice stays payable, and invoices per person per hour.
# MAX_INVOICE_SATS=100000
# INVOICE_EXPIRY_MINUTES=60
# MAX_INVOICES_PER_HOUR=10

# Invoice amounts in sats offered as buttons in Anagram, next to a Custom button: up to four,
# each at most MAX_INVOICE_SATS, comma-separated, or "off" for no invoice buttons.
# INVOICE_PRESETS=1000,5000

# ---- Nostr identity and relays ---------------------------------------------------------

# Optional identity. Leave unset to reuse the saved key or generate one on first start.
# A different key needs a different DATA_DIR; existing account state is never overwritten.
# NSEC=nsec1...

# Profile display name.
# NAME="LNbits Wallet"

# Optional. Defaults match Anagram's app relays. Comma-separated websocket URLs.
# RELAYS=wss://relay.nostr.com,wss://relay.damus.io,wss://nostr.mom,wss://nostr.bitcoiner.social,wss://nos.lol

# Persistent identity, dedupe markers, link times and delivery queue.
# DATA_DIR=./data

# Optional HTTPS profile picture URL and NIP-05 identifier.
# PICTURE_URL=https://your-site.example/wallet.png
# NIP05=wallet@your-domain.example
