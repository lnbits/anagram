[Unit]
Description=Anagram GitHub Issue Agent bot
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/github-issue-agent
ExecStart=/usr/bin/node --env-file-if-exists=/opt/github-issue-agent/.env /opt/github-issue-agent/bot.js
Environment=DATA_DIR=/var/lib/anagram-github-issue-agent
StateDirectory=anagram-github-issue-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# Long enough for a GitHub request in progress (20 s timeout) to record its outcome.
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# IPv4/IPv6 for relays, Ollama and GitHub; Unix sockets for the system DNS resolver.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
