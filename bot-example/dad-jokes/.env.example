# Optional identity. Leave unset to reuse the saved key or generate one on first start.
# A different key needs a different DATA_DIR; existing account state is never overwritten.
# NSEC=nsec1...

# Profile display name. Defaults to Dad Jokes (Example Anagram Bot).
# NAME="Dad Jokes (Example Anagram Bot)"

# Optional. Defaults match Anagram's app relays. Comma-separated websocket URLs.
# RELAYS=wss://relay.nostr.com,wss://relay.damus.io,wss://nostr.mom,wss://nostr.bitcoiner.social,wss://nos.lol

# Persistent identity, invitations, subscriptions and delivery queue.
# DATA_DIR=./data

# Optional override for the built-in hosted profile picture. No upload is needed.
# PICTURE_URL=https://your-site.example/dad.png

# Optional NIP-05 identifier; your domain must map this name to the bot public key.
# NIP05=dad@your-domain.example

# Optional public group links/naddrs, separated by commas.
# PUBLIC_GROUPS=naddr1...

# One reply per sender per this many seconds (across all chats); 0 disables.
# COOLDOWN_SECONDS=5
