{
  "name": "anagram",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
    "quality:all": "npm run check",
    "test:unit": "vitest run",
    "test:e2e:local": "playwright test",
    "test:e2e:memory": "playwright test --config playwright.memory.config.ts",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "release:version": "node scripts/set-release-version.mjs",
    "verify:iroh": "node scripts/verify-iroh.mjs",
    "assets:social": "node scripts/render-social-cards.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vue/reactivity": "^3.5",
    "nostr-tools": "^2",
    "qrcode": "^1.5.4",
    "@scure/bip39": "2.0.1",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/qrcode": "^1",
    "@types/ws": "^8.18.2",
    "fake-indexeddb": "^6",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}
