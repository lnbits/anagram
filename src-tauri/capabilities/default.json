{
  "identifier": "default",
  "description": "Main Anagram window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "magnet:*" }]
    },
    "allow-read-private-key",
    "allow-write-private-key",
    "allow-remove-private-key"
  ]
}
