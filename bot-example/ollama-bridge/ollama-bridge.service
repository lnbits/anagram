[Unit]
Description=Anagram Ollama Bridge bot
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/ollama-bridge
ExecStart=/usr/bin/node --env-file-if-exists=/opt/ollama-bridge/.env /opt/ollama-bridge/bot.js
Environment=DATA_DIR=/var/lib/anagram-ollama-bridge
StateDirectory=anagram-ollama-bridge
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# IPv4/IPv6 for relays and Ollama; Unix sockets for the system DNS resolver.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
